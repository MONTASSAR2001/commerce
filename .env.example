# KRONOS Streetwear + Admin Studio — Supabase Environment Variables
# Copy this file to `.env.local` and fill in your Supabase project credentials.
# Never expose SUPABASE_SERVICE_ROLE_KEY in frontend Vite env files.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional Admin Studio Display Defaults
VITE_KRONOS_ADMIN_NAME=Montassar Zarai
VITE_KRONOS_ADMIN_EMAIL=montassarzarai0@gmail.com

# Free Groq AI Key (OpenAI-compatible endpoint: https://api.groq.com/openai/v1)
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=openai/gpt-oss-120b

# Independent Deployment Mode ('all' | 'store' | 'admin')
# Set VITE_APP_MODE=store on Storefront Vercel project, VITE_APP_MODE=admin on Admin Vercel project
VITE_APP_MODE=all
VITE_STOREFRONT_URL=
VITE_ADMIN_URL=

